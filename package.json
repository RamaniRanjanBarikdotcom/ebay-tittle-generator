{
  "name": "ebay-title-generator",
  "version": "1.0.0",
  "description": "Desktop app for generating optimized eBay product titles",
  "main": "out/main/index.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-native-sqlite.mjs",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build:app": "electron-vite build",
    "dist": "npm run build:app && electron-builder --win",
    "build": "npm run dist",
    "build:win": "npm run dist",
    "build:win:dir": "npm run build:app && electron-builder --win dir --x64 --publish never",
    "build:win:portable": "npm run build:app && electron-builder --win portable --x64 --publish never",
    "build:win:setup": "npm run build:app && electron-builder --win nsis --x64 --publish never",
    "build:mac": "npm run build:app && electron-builder --mac --publish never",
    "build:linux": "npm run build:app && electron-builder --linux --publish never",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "ebay",
    "title",
    "generator",
    "electron"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "ag-grid-community": "^31.0.0",
    "ag-grid-react": "^31.0.0",
    "antd": "^5.12.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.0",
    "electron-log": "^5.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.300.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^22.19.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^16.0.0",
    "playwright": "^1.40.0",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.yourbrand.ebaytitlegenerator",
    "productName": "eBay Title Generator",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "database/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "eBay Title Generator"
    }
  }
}
